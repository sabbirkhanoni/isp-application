# Runtime connection (Supabase: pooled/transaction connection string, port 6543)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/isp_dev
# Migrations only (Supabase: direct connection string, port 5432)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/isp_dev

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Production: __Host-sid with COOKIE_SECURE=true
SESSION_COOKIE_NAME=sid
COOKIE_SECURE=false
SESSION_TTL_HOURS=168

# Comma separated origins allowed to send state-changing requests (the Cloudflare Pages URL)
ALLOWED_ORIGINS=http://localhost:5173
# Number of reverse-proxy hops in front of the API (Render = 1)
TRUST_PROXY_HOPS=0

LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
DB_POOL_MAX=5

# Used only by `npm run db:seed`
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-please-12
SEED_ADMIN_FULL_NAME=ISP Owner

# Background jobs (invoice generation, SMS reminders). Turn on in production.
BACKGROUND_JOBS=false
# SMS: "log" only records messages (safe default). "http" posts to your SMS provider.
SMS_DRIVER=log
# Owner's mobile (01XXXXXXXXX): gets last month's summary by SMS on the 1st. Empty = off.
OWNER_PHONE=
# SMS_API_URL=https://sms-provider.example/api/send
# SMS_API_KEY=
# SMS_SENDER_ID=
SMS_MONTHLY_CAP=5000
SMS_LOCALE=bn
# Routers: ROUTER_SECRET encrypts router passwords (16+ random characters; keep it safe, never change it later).
# ROUTER_SECRET=
# true = router changes are only logged, nothing is sent to a router (safe for a first trial).
ROUTER_DRY_RUN=false
# Automatic suspension of overdue customers is OFF by default (BR: manual suspend).
AUTO_SUSPEND=false
AUTO_SUSPEND_GRACE_DAYS=3

# Same random text as in the Cloudflare Pages settings. Leave empty for local development.
PROXY_SECRET=
